{
  "name": "nytreact",
  "version": "1.0.0",
  "description": "NYT API website",
  "main": "server.js",
  "scripts": {
    "start": "if-env NODE_ENV=production && npm run start:prod || npm run start:dev",
    "start:prod": "node server.js",
    "start:dev": "concurrently \"nodemon --ignore 'client/*'\" \"npm run client\"",
    "client": "cd client && npm run start",
    "seed": "node scripts/seedDB.js",
    "install": "cd client && yarn install",
    "build": "cd client && npm run build",
    "heroku-postbuild": "npm run build",
    "lint": "eslint **/*.js --quiet --ignore-pattern client/**",
    "fix": "eslint --fix . --ignore-pattern client/**"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^3.5.0",
    "eslint": "^5.8.0",
    "nodemon": "^1.11.0"
  },
  "dependencies": {
    "aws-sdk": "^2.353.0",
    "axios": "^0.18.0",
    "bcrypt-nodejs": "^0.0.3",
    "body-parser": "^1.18.3",
    "cookie-parser": "^1.4.3",
    "cors": "^2.8.5",
    "dotenv": "^6.1.0",
    "express": "^4.16.3",
    "express-fileupload": "^1.0.0",
    "express-session": "^1.15.6",
    "http-errors": "^1.7.1",
    "if-env": "^1.0.4",
    "mongoose": "^5.3.9",
    "morgan": "^1.9.1",
    "passport": "^0.4.0",
    "passport-local": "^1.0.0",
    "react-router-dom": "^4.3.1"
  }
}
