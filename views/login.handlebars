<div class="login">
    {{#if error}}
    <span class="error">{{error}}</span>
    {{/if}}
    <h3>Login</h3>
    <form method="POST" action="/login">
        <input type="text" name="username" placeholder="Username"><br>
        <input type="password" name="password" placeholder="Password"><br>
        <button type="submit">Login</button>
    </form>
</div>